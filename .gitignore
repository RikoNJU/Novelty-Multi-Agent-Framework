Thumbs.db
.DS_Store
*.tmp
*.log
:memory:.ses
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 本地样例论文：原稿不入库（处理产物在已忽略的 outputs/<paper_id>/）
examples/MG19333vrw.pdf
examples/OOP_NeurIPS2025.pdf
# 旧版运行产物；新产物统一写入 outputs/<paper_id>/
output/
# 保留 outputs 根目录，但忽略每篇论文的运行产物
outputs/*
!outputs/.gitkeep
!outputs/README.md
# 实验报告和精简 Runtime 审计产物归档到 docs/experiments；
# 完整过程文件仍保存在已忽略的 outputs/<paper_id>/
!docs/experiments/
!docs/experiments/**
.venv/
.env
.env.*
!.env.example
!**/.env.example
backend/src/*/data/*
!backend/src/*/data/.gitignore
.codegraph/
# 本地任务指令，不同步到 Git
/task/

# Frontend build tools and generated bundles
frontend/node_modules/
frontend/dist/

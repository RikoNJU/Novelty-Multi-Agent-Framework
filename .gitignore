Thumbs.db
.DS_Store
*.tmp
*.log
:memory:.ses
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 本地样例论文：原稿不入库（处理产物在已忽略的 outputs/<paper_id>/）
examples/MG19333vrw.pdf
# 旧版运行产物；新产物统一写入 outputs/<paper_id>/
output/
# 保留 outputs 根目录，但忽略每篇论文的运行产物
outputs/*
!outputs/.gitkeep
!outputs/README.md
# 实验报告归档到 docs/experiments；实际过程文件保存在已忽略的 outputs/experiments
!docs/experiments/
!docs/experiments/**
# Runtime Debug 每次运行都会自动归档 summary 到该目录，忽略以免污染仓库；
# 确有需要归档某次运行时，用 git add -f 显式加入
docs/experiments/runtime/
.venv/
.env
.env.*
!.env.example
!**/.env.example
backend/src/*/data/*
!backend/src/*/data/.gitignore
.codegraph/
# 本地任务指令，不同步到 Git
/task/

Thumbs.db
.DS_Store
*.tmp
*.log
:memory:.ses
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 旧版运行产物；新产物统一写入 outputs/<paper_id>/
output/
# 保留 outputs 根目录，但忽略每篇论文的运行产物
outputs/*
!outputs/.gitkeep
!outputs/README.md
# 实验报告与复现实验产物统一归档到 docs/experiments，并纳入版本控制
!docs/experiments/
!docs/experiments/**
.venv/
.env
.env.*
!.env.example
!**/.env.example
backend/src/*/data/*
!backend/src/*/data/.gitignore
.codegraph/
# 本地任务指令，不同步到 Git
/task/

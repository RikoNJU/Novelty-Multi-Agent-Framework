{
  "version": 1,
  "model": {"alias": "deepseek-flash", "temperature": 0.3, "max_tokens": 4096, "timeout_seconds": 300, "tool_choice": "auto"},
  "prompt": "research/native_tool_loop",
  "harness": {"max_turns": 12, "max_total_tool_calls": 10, "per_tool_limits": {"database_search": 2, "web_search": 3, "browser": 3, "reader": 8}},
  "tools": {
    "database_search": {"active_source": "arxiv", "candidate_limit_per_task": 8, "candidate_excerpt_chars": 2000, "full_text_limit_per_task": 8, "providers": {"arxiv": {"enabled": true, "min_interval": 3.0, "timeout": 20.0, "max_retries": 2}, "null_catalog": {"enabled": true, "testing_only": true}}},
    "reader": {"max_chars_per_read": 8000, "max_total_read_chars": 48000}
  }
}

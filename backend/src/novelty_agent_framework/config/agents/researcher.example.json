{
  "version": 1,
  "model": {
    "alias": "deepseek-flash",
    "temperature": 0.3,
    "max_tokens": 4096,
    "timeout_seconds": 300,
    "tool_choice": "auto",
    "enable_thinking": false
  },
  "prompt": "research/native_tool_loop",
  "harness": {
    "max_turns": 12,
    "max_total_tool_calls": 10,
    "per_tool_limits": {
      "database_search": 3,
      "web_search": 5,
      "browser": 3,
      "reader": 8
    }
  },
  "tools": {
    "database_search": {
      "active_source": "arxiv",
      "candidate_limit_per_task": 8,
      "candidate_excerpt_chars": 2000,
      "full_text_limit_per_task": 8,
      "max_concurrency": 4,
      "providers": {
        "arxiv": {
          "enabled": true,
          "min_interval_seconds": 3,
          "timeout_seconds": 20,
          "max_retries": 2,
          "full_text_max_chars": 100000
        },
        "sciencedirect": {
          "enabled": false,
          "api_key_env": "ELSEVIER_API_KEY",
          "institution_token_env": "ELSEVIER_INST_TOKEN",
          "base_url": "https://api.elsevier.com",
          "timeout_seconds": 30,
          "max_retries": 2,
          "retry_backoff_seconds": 0.5,
          "search_min_interval_seconds": 0.5,
          "article_min_interval_seconds": 0.1,
          "abstract_enrichment_limit": 4,
          "full_text_max_chars": 100000,
          "max_query_chars": 250
        },
        "null_catalog": {
          "enabled": true,
          "testing_only": true
        }
      }
    },
    "web_search": {
      "backend": "baidu",
      "default_max_results": 10,
      "max_results_per_call": 50,
      "baidu": {
        "timeout_seconds": 30
      }
    },
    "browser": {
      "backend": "playwright",
      "network_mode": "inherit",
      "navigation_timeout_ms": 30000,
      "max_html_chars": 2000000,
      "max_text_chars": 500000
    },
    "reader": {
      "default_chars_per_read": 8000,
      "max_chars_per_read": 16000,
      "max_total_read_chars": 48000
    }
  }
}

+
+def require_preflight(config: ApplicationConfig, **kwargs: Any) -> list[dict[str, str]]:
+    issues = preflight_config(config, **kwargs)
+    if any(item["severity"] == "error" for item in issues):
+        raise ConfigurationPreflightError(issues)
+    return issues

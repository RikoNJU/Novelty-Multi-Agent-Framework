+"""Fault-injection checks for opt-in, invocation-isolated evidence checkpoints."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+from dataclasses import replace
+
+import pytest
+
+from backend.env import ModelResponse, ModelToolCall

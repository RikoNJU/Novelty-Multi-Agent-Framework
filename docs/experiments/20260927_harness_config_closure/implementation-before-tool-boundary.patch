+
+
+def test_matching_count_is_recorded_without_invalidating_next_call(monkeypatch, tmp_path):
+    monkeypatch.setattr("urllib.request.urlopen", lambda request, **k: Response(chat_response(60)))
+    manager = runtime(tmp_path)

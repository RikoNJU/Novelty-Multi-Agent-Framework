+    def __init__(self, issues: list[dict[str, str]]) -> None:
+        self.issues = issues
+        details = "; ".join(f"{item['code']} at {item['path']}: {item['message']}"
+                            for item in issues if item["severity"] == "error")
+        super().__init__("configuration preflight failed: " + details)

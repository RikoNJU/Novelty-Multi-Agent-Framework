      <a href="/search/?searchtype=author&amp;query=Kim%2C+J">Jiwan Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Uddin%2C+M+G">MD Gius Uddin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+W">Wonseok Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Park%2C+J">Jihun Park</a>, 
      

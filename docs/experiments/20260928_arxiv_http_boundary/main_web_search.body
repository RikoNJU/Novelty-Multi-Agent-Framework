      <a href="/search/?searchtype=author&amp;query=Jeon%2C+D+W">Dong Won Jeon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+D">Dohyung Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yao%2C+L">Lide Yao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lahtinen%2C+J">Jouko Lahtinen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jang%2C+G">Gyunghyun Jang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Min%2C+S">Soohyun Min</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Megra%2C+Y+T">Yonas Tsegaye Megra</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cui%2C+X">Xiaoqi Cui</a>, 
      

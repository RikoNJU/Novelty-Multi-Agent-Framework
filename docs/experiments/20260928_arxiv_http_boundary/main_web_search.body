    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Cahoon%2C+J+L">Jordan L. Cahoon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Stanwyck%2C+C+O">Chloe O. Stanwyck</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Somani%2C+S">Sulaiman Somani</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chung%2C+P">Philip Chung</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Keet%2C+K+R">Kevin R Keet</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Black%2C+K+C">Kameron C. Black</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fisher%2C+A+T">Andrea T. Fisher</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Khemani%2C+S">Sarita Khemani</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+J">Jerry Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ma%2C+S">Stephen Ma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Maharaj%2C+S+K">Saloni K. Maharaj</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pandya%2C+R+M">Rita M. Pandya</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Perez-Guerrero%2C+E">Eduardo Perez-Guerrero</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pillai%2C+P">Priyanka Pillai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shieh%2C+L">Lisa Shieh</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+D+J+H">David J. H. Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xie%2C+J">James Xie</a>, 
      
      <a href="/search/?searchtype=author&amp;query=McAvoy%2C+J+C">James C. McAvoy</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Nguyen%2C+T">Teresa Nguyen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tran%2C+J">Jessica Tran</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yin%2C+L">Lucy Yin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+B">Bridget Lin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Callahan%2C+A">Alison Callahan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fries%2C+J+A">Jason A. Fries</a>, 
      

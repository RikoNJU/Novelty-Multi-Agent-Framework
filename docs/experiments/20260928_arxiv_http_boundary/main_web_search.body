        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.29635">pdf</a>, <a href="https://arxiv.org/ps/2609.29635">ps</a>, <a href="https://arxiv.org/format/2609.29635">other</a>]&nbsp;</span>

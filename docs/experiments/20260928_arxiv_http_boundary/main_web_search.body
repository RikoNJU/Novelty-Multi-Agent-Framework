  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2609.29868">arXiv:2609.29868</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.29868">pdf</a>]&nbsp;</span>

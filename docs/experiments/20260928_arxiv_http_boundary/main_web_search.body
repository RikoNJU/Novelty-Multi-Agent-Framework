  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2609.29357">arXiv:2609.29357</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.29357">pdf</a>, <a href="https://arxiv.org/ps/2609.29357">ps</a>, <a href="https://arxiv.org/format/2609.29357">other</a>]&nbsp;</span>

  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2609.30229">arXiv:2609.30229</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.30229">pdf</a>, <a href="https://arxiv.org/ps/2609.30229">ps</a>, <a href="https://arxiv.org/format/2609.30229">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">

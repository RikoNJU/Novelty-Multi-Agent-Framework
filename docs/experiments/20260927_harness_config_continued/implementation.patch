+    finally:
+        manager.deactivate()
+    admission = saved(manager)["context_admission"]
+    assert admission["status"] == "admitted"
+    assert admission["output_reservation_field"] == "max_completion_tokens"
+    assert admission["requested_total_tokens"] == 100
+

        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.23782">pdf</a>, <a href="https://arxiv.org/ps/2609.23782">ps</a>, <a href="https://arxiv.org/format/2609.23782">other</a>]&nbsp;</span>

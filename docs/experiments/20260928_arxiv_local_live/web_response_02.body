      <div class="column is-two-thirds-tablet">
        <p style="margin-bottom: .5em">Query: <a href="/search/advanced?classification-include_cross_list=include&amp;abstracts=show&amp;size=25&amp;order=-announced_date_first&amp;terms-0-operator=AND&amp;terms-0-term=distributed&amp;terms-0-field=abstract&amp;terms-1-operator=AND&amp;terms-1-term=graph&amp;terms-1-field=abstract&amp;terms-2-operator=AND&amp;terms-2-term=neural&amp;terms-2-field=abstract&amp;terms-3-operator=AND&amp;terms-3-term=network&amp;terms-3-field=abstract">order: -announced_date_first; size: 25; include_cross_list: True; terms: AND abstract=distributed; AND abstract=graph; AND abstract=neural; AND abstract=network</a></p>

        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.28262">pdf</a>, <a href="https://arxiv.org/ps/2609.28262">ps</a>, <a href="https://arxiv.org/format/2609.28262">other</a>]&nbsp;</span>

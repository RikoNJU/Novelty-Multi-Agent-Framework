    <p class="title is-5 mathjax">
      
        Droop-Aware Foundation Model Power Flow
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Sanjani%2C+K">Khezr Sanjani</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+P">Peng Zhang</a>
      

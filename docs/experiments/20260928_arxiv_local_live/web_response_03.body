      <a href="/search/?searchtype=author&amp;query=Pan%2C+R">Rong Pan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+Y">Yuzhou Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+Y">Yixuan He</a>
      

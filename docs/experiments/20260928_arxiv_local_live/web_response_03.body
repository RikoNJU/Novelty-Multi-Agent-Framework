        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.26073">pdf</a>, <a href="https://arxiv.org/ps/2609.26073">ps</a>, <a href="https://arxiv.org/format/2609.26073">other</a>]&nbsp;</span>

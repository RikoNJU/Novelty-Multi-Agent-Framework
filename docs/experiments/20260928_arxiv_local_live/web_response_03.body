        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.28979">pdf</a>, <a href="https://arxiv.org/ps/2609.28979">ps</a>, <a href="https://arxiv.org/format/2609.28979">other</a>]&nbsp;</span>
      </p>

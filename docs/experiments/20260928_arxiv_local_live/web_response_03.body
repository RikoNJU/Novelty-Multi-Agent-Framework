        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.28782">pdf</a>, <a href="https://arxiv.org/ps/2609.28782">ps</a>, <a href="https://arxiv.org/format/2609.28782">other</a>]&nbsp;</span>
